---
# Copy to secrets.yml and encrypt with ansible-vault, or pass: ansible-playbook ... -e @secrets.yml
harbor_docker_username: YOUR_HARBOR_USER
harbor_docker_password: YOUR_HARBOR_PASSWORD
encryption_key: YOUR_ENCRYPTION_KEY
keycloak_admin_password: YOUR_KEYCLOAK_ADMIN_PASSWORD

# Optional (set apply_cloudsentry_secrets: true in all.yml)
# gemini_api_key: ""
# base_url: ""
# app_aws_access_key_id: ""
# app_aws_secret_access_key: ""
