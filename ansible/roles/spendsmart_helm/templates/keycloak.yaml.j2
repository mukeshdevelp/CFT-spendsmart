apiVersion: apps/v1
kind: Deployment
metadata:
  name: keycloak
  namespace: {{ k8s_namespace }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app: keycloak
  template:
    metadata:
      labels:
        app: keycloak
    spec:
      nodeSelector:
        spendsmart.io/workload: frontend
      containers:
        - name: keycloak
          image: {{ keycloak_image }}
          args: ["start-dev"]
          env:
            - name: KEYCLOAK_ADMIN
              value: "{{ keycloak_admin_user }}"
            - name: KEYCLOAK_ADMIN_PASSWORD
              value: "{{ keycloak_admin_password }}"
            - name: KC_HTTP_PORT
              value: "8080"
            - name: KC_HOSTNAME_STRICT
              value: "false"
            - name: KC_HTTP_ENABLED
              value: "true"
          ports:
            - containerPort: 8080
          readinessProbe:
            httpGet:
              path: /realms/master
              port: 8080
            initialDelaySeconds: 30
            periodSeconds: 10
          resources:
            requests:
              cpu: 250m
              memory: 512Mi
            limits:
              memory: 1536Mi
---
apiVersion: v1
kind: Service
metadata:
  name: keycloak
  namespace: {{ k8s_namespace }}
spec:
  selector:
    app: keycloak
  ports:
    - name: http
      port: 8080
      targetPort: 8080
