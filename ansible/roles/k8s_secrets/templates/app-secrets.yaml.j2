apiVersion: v1
kind: Namespace
metadata:
  name: {{ k8s_namespace }}
---
{% if harbor_docker_username | length > 0 and harbor_docker_password | length > 0 %}
apiVersion: v1
kind: Secret
metadata:
  name: harbor-ldc-coe-regcred
  namespace: {{ k8s_namespace }}
type: kubernetes.io/dockerconfigjson
stringData:
  .dockerconfigjson: '{{ docker_auth_json | to_json }}'
---
{% endif %}
{% if encryption_key | length > 0 %}
apiVersion: v1
kind: Secret
metadata:
  name: encryption-key
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  ENCRYPTION_KEY: {{ encryption_key | quote }}
---
{% endif %}
{% if gemini_api_key | length > 0 %}
apiVersion: v1
kind: Secret
metadata:
  name: gemini-key
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  GEMINI_API_KEY: {{ gemini_api_key | quote }}
---
{% endif %}
{% if base_url | length > 0 %}
apiVersion: v1
kind: Secret
metadata:
  name: base-url
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  BASE_URL: {{ base_url | quote }}
---
{% endif %}
{% if aws_access_key_id | length > 0 and aws_secret_access_key | length > 0 %}
apiVersion: v1
kind: Secret
metadata:
  name: aws-access
  namespace: {{ k8s_namespace }}
type: Opaque
stringData:
  AWS_ACCESS_KEY_ID: {{ aws_access_key_id | quote }}
  AWS_SECRET_ACCESS_KEY: {{ aws_secret_access_key | quote }}
---
{% endif %}
