pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }

  parameters {
    choice(
      name: 'AWS_REGION',
      choices: ['us-east-1', 'ap-south-1'],
      description: 'AWS region (use us-east-1 for CUR)'
    )
    string(
      name: 'CFN_STACK_NAME',
      defaultValue: 'spendsmart-dev',
      description: 'CloudFormation root stack (main.yml)'
    )
    string(
      name: 'HELM_STACK_NAME',
      defaultValue: 'spendsmart-dev-helm',
      description: 'CloudFormation stack for helm-main.yml'
    )
    string(
      name: 'CFN_TEMPLATE_BUCKET',
      defaultValue: '',
      description: 'S3 bucket for packaged templates and bastion-assets (required)'
    )
    string(
      name: 'S3_BUCKET_NAME',
      defaultValue: 'athena-results-spendsmart-dev',
      description: 'Data/CUR S3 bucket parameter for main.yml'
    )
    string(
      name: 'EXISTING_EC2_KEY_NAME',
      defaultValue: 'mukesh',
      description: 'EC2 key pair in region'
    )
    string(
      name: 'BASTION_SSH_CIDRS',
      defaultValue: '0.0.0.0/0',
      description: 'Bastion SSH CIDR list'
    )
    string(
      name: 'NAME_PREFIX',
      defaultValue: 'spendsmart-dev',
      description: 'NamePrefix for Secrets Manager paths and Helm'
    )
    string(
      name: 'SPENDSMART_VALUES_S3_URI',
      defaultValue: '',
      description: 'Optional Helm values URI; empty uses s3://<bucket>/client-a-values.yaml when upload enabled'
    )
    booleanParam(
      name: 'SKIP_INFRA_DEPLOY',
      defaultValue: false,
      description: 'Skip infra stages (secrets + Helm only)'
    )
    booleanParam(
      name: 'WAIT_FOR_INFRA',
      defaultValue: true,
      description: 'Wait for infra stack create/update'
    )
    booleanParam(
      name: 'WAIT_FOR_HELM_STACK',
      defaultValue: true,
      description: 'Wait for Helm CloudFormation stack'
    )
    booleanParam(
      name: 'UPLOAD_CLIENT_VALUES',
      defaultValue: true,
      description: 'Upload client-a-values.yaml to template bucket'
    )
    choice(
      name: 'INSTALL_ALB_CONTROLLER',
      choices: ['true', 'false'],
      description: 'Install AWS Load Balancer Controller in Helm stack'
    )
    string(
      name: 'HARBOR_DOCKER_SERVER',
      defaultValue: 'harbor.ldc.opstree.dev',
      description: 'Harbor registry host'
    )
    string(
      name: 'HARBOR_DOCKER_USERNAME',
      defaultValue: '',
      description: 'Harbor user or robot name'
    )
    password(
      name: 'HARBOR_DOCKER_PASSWORD',
      defaultValue: '',
      description: 'Harbor password or robot token'
    )
    password(
      name: 'ENCRYPTION_KEY',
      defaultValue: '',
      description: 'Optional; Helm module may generate encryption-key if empty'
    )
    password(
      name: 'GEMINI_API_KEY',
      defaultValue: '',
      description: 'Gemini API key (gemini-key secret)'
    )
    string(
      name: 'BASE_URL',
      defaultValue: '',
      description: 'base-url secret value'
    )
    string(
      name: 'AWS_ACCESS_KEY_ID',
      defaultValue: '',
      description: 'Optional aws-access secret'
    )
    password(
      name: 'AWS_SECRET_ACCESS_KEY',
      defaultValue: '',
      description: 'Optional aws-access secret'
    )
  }

  environment {
    AWS_DEFAULT_REGION = "${params.AWS_REGION}"
    CFN_STACK_NAME = "${params.CFN_STACK_NAME}"
    HELM_STACK_NAME = "${params.HELM_STACK_NAME}"
    CFN_TEMPLATE_BUCKET = "${params.CFN_TEMPLATE_BUCKET}"
    S3_BUCKET_NAME = "${params.S3_BUCKET_NAME}"
    EXISTING_EC2_KEY_NAME = "${params.EXISTING_EC2_KEY_NAME}"
    BASTION_SSH_CIDRS = "${params.BASTION_SSH_CIDRS}"
    NAME_PREFIX = "${params.NAME_PREFIX}"
    SPENDSMART_VALUES_S3_URI = "${params.SPENDSMART_VALUES_S3_URI}"
    SKIP_INFRA_DEPLOY = "${params.SKIP_INFRA_DEPLOY}"
    UPLOAD_CLIENT_VALUES = "${params.UPLOAD_CLIENT_VALUES}"
    INSTALL_ALB_CONTROLLER = "${params.INSTALL_ALB_CONTROLLER}"
    ANSIBLE_CONFIG = "${WORKSPACE}/ansible/ansible.cfg"
    ANSIBLE_COLLECTIONS_PATH = "${WORKSPACE}/ansible/collections"
    ANSIBLE_LOCAL_TMP = "${WORKSPACE}/.ansible/tmp"
    RUNTIME_SECRETS_JSON = 'jenkins-runtime-secrets.json'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Install Ansible collections') {
      steps {
        sh '''
          ansible-galaxy collection install -r ansible/requirements.yml -p ansible/collections
        '''
      }
    }

    stage('Preflight') {
      steps {
        sh 'ansible-playbook ansible/playbooks/preflight.yml'
      }
    }

    stage('Infra: prepare & package') {
      when {
        expression { return !params.SKIP_INFRA_DEPLOY }
      }
      steps {
        sh 'ansible-playbook ansible/playbooks/infra.yml'
      }
    }

    stage('Infra: deploy') {
      when {
        expression { return !params.SKIP_INFRA_DEPLOY }
      }
      steps {
        sh 'ansible-playbook ansible/playbooks/deploy_infra.yml'
      }
    }

    stage('Infra: wait') {
      when {
        allOf {
          expression { return !params.SKIP_INFRA_DEPLOY }
          expression { return params.WAIT_FOR_INFRA }
        }
      }
      steps {
        sh 'ansible-playbook ansible/playbooks/wait_infra.yml'
      }
    }

    stage('Wait for EKS') {
      steps {
        sh 'ansible-playbook ansible/playbooks/wait_eks.yml'
      }
    }

    stage('Bastion assets (helm-only)') {
      when {
        expression { return params.SKIP_INFRA_DEPLOY }
      }
      steps {
        sh 'ansible-playbook ansible/playbooks/sync_bastion_assets.yml'
      }
    }

    stage('Apply Kubernetes secrets') {
      steps {
        script {
          def secrets = [
            harbor_docker_server: params.HARBOR_DOCKER_SERVER,
            harbor_docker_username: params.HARBOR_DOCKER_USERNAME,
            harbor_docker_password: params.HARBOR_DOCKER_PASSWORD,
            encryption_key: params.ENCRYPTION_KEY,
            gemini_api_key: params.GEMINI_API_KEY,
            base_url: params.BASE_URL,
            aws_access_key_id: params.AWS_ACCESS_KEY_ID,
            aws_secret_access_key: params.AWS_SECRET_ACCESS_KEY,
          ]
          writeJSON file: env.RUNTIME_SECRETS_JSON, json: secrets
        }
        sh 'ansible-playbook ansible/playbooks/secrets.yml'
      }
      post {
        always {
          sh 'rm -f "${RUNTIME_SECRETS_JSON}"'
        }
      }
    }

    stage('Helm: upload values') {
      when {
        allOf {
          expression { return params.SKIP_INFRA_DEPLOY }
          expression { return params.UPLOAD_CLIENT_VALUES }
        }
      }
      steps {
        sh 'ansible-playbook ansible/playbooks/upload_values.yml'
      }
    }

    stage('Helm: deploy') {
      steps {
        sh 'ansible-playbook ansible/playbooks/helm.yml'
      }
    }

    stage('Helm: wait') {
      when {
        expression { return params.WAIT_FOR_HELM_STACK }
      }
      steps {
        sh 'ansible-playbook ansible/playbooks/wait_helm.yml'
      }
    }
  }

  post {
    failure {
      sh '''
        set +e
        aws cloudformation describe-stack-events --stack-name "${CFN_STACK_NAME}" \
          --region "${AWS_REGION}" --max-items 10 \
          --query 'StackEvents[?contains(ResourceStatus, `FAILED`)].[LogicalResourceId,ResourceStatusReason]' \
          --output table
        aws cloudformation describe-stack-events --stack-name "${HELM_STACK_NAME}" \
          --region "${AWS_REGION}" --max-items 10 \
          --query 'StackEvents[?contains(ResourceStatus, `FAILED`)].[LogicalResourceId,ResourceStatusReason]' \
          --output table
      '''
    }
  }
}
